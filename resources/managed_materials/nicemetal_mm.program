// Unified Cg + GLSL program definitions for nicemetal vehicle materials.
//
// - On Windows (Direct3D9) and Linux (OpenGL with Plugin_CgProgramManager),
//   OGRE's UnifiedHighLevelGpuProgram selects the *_CG delegate (using the
//   original nicemetal_mm.cg shaders).
// - On macOS Apple Silicon (where NVIDIA's x86-only Cg plugin is unavailable),
//   *_CG resolves to a NullProgram (isSupported() == false) and OGRE
//   automatically selects the *_GLSL delegate (nicemetal_mm_*.glsl).

// ---- NiceMetal_VS_mm ----
vertex_program NiceMetal_VS_mm_GLSL glsl
{
    source nicemetal_mm_vs.glsl
    default_params
    {
        param_named_auto worldviewproj worldviewproj_matrix
        param_named_auto lightPosition light_position_object_space 0
        param_named_auto eyePosition camera_position_object_space
    }
}

vertex_program NiceMetal_VS_mm_CG cg
{
    source nicemetal_mm.cg
    entry_point main_nicemetal_vp
    profiles vs_1_1 arbvp1
    default_params
    {
        param_named_auto worldviewproj worldviewproj_matrix
        param_named_auto lightPosition light_position_object_space 0
        param_named_auto eyePosition camera_position_object_space
    }
}

vertex_program NiceMetal_VS_mm unified
{
    delegate NiceMetal_VS_mm_GLSL
    delegate NiceMetal_VS_mm_CG
}

// ---- NiceMetal_PS_mm ----
fragment_program NiceMetal_PS_mm_GLSL glsl
{
    source nicemetal_mm_fp.glsl
    default_params
    {
        param_named_auto lightDiffuse light_diffuse_colour 0
        param_named_auto lightSpecular light_specular_colour 0
        param_named exponent float 127
        param_named_auto ambient ambient_light_colour
        param_named Diffuse_Map int 0
        param_named Specular_Map int 1
        param_named Dmg_Diffuse_Map int 2
    }
}

fragment_program NiceMetal_PS_mm_CG cg
{
    source nicemetal_mm.cg
    entry_point main_nicemetal_fp
    profiles ps_2_0 arbfp1
    default_params
    {
        param_named_auto lightDiffuse light_diffuse_colour 0
        param_named_auto lightSpecular light_specular_colour 0
        param_named exponent float 127
        param_named_auto ambient ambient_light_colour
    }
}

fragment_program NiceMetal_PS_mm unified
{
    delegate NiceMetal_PS_mm_GLSL
    delegate NiceMetal_PS_mm_CG
}

