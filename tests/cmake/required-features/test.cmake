cmake_minimum_required(VERSION 3.16)
# cmake -DTEST_BINARY_DIR=<scratch-directory> -P tests/cmake/required-features/test.cmake
if(NOT DEFINED TEST_BINARY_DIR OR TEST_BINARY_DIR STREQUAL "")
    message(FATAL_ERROR "Set TEST_BINARY_DIR to a scratch directory for configure fixtures")
endif()
get_filename_component(TEST_BINARY_DIR "${TEST_BINARY_DIR}" ABSOLUTE)

function(configure_case name requirements missing_package missing_target expected_error)
    set(build_dir "${TEST_BINARY_DIR}/${name}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -S "${CMAKE_CURRENT_LIST_DIR}" -B "${build_dir}"
        "-DROR_REQUIRED_FEATURES=${requirements}"
        "-DTEST_MISSING_PACKAGE=${missing_package}"
        "-DTEST_MISSING_TARGET=${missing_target}"
        ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${TEST_BINARY_DIR}/${name}.log" "${output}${error}")
    if(expected_error STREQUAL "")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${name}: configure failed:\n${output}${error}")
        endif()
        if(NOT EXISTS "${build_dir}/ror-features.cmake")
            message(FATAL_ERROR "${name}: missing effective feature receipt")
        endif()
    else()
        string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${output}${error}")
        if(result EQUAL 0 OR NOT diagnostic MATCHES "${expected_error}")
            message(FATAL_ERROR "${name}: expected '${expected_error}', got ${result}:\n${output}${error}")
        endif()
        if(EXISTS "${build_dir}/ror-features.cmake")
            message(FATAL_ERROR "${name}: failed gate left a receipt")
        endif()
    endif()
    message(STATUS "${name}: passed")
endfunction()

configure_case(empty "" "ALL" "" "" -DROR_USE_OPENAL=ON)
file(READ "${TEST_BINARY_DIR}/empty/CMakeCache.txt" cache)
if(NOT cache MATCHES "ROR_USE_OPENAL:INTERNAL=ON")
    message(FATAL_ERROR "Fixture did not preserve requested cache ON")
endif()
file(READ "${TEST_BINARY_DIR}/empty/effective-openal.txt" effective)
if(NOT effective STREQUAL "OFF")
    message(FATAL_ERROR "Fixture did not resolve normal variable OFF")
endif()
file(READ "${TEST_BINARY_DIR}/empty/ror-features.cmake" receipt)
set(expected [=[# Effective optional features after dependency discovery.
set(ROR_REQUIRED_FEATURES "")
set(ROR_USE_OPENAL OFF)
set(ROR_USE_DISCORD_RPC OFF)
set(ROR_USE_SOCKETW OFF)
set(ROR_USE_ANGELSCRIPT OFF)
set(ROR_USE_CURL OFF)
set(ROR_USE_CAELUM OFF)
set(ROR_USE_PAGED OFF)
]=])
if(NOT receipt STREQUAL expected)
    message(FATAL_ERROR "Empty requirements receipt does not describe effective OFF values")
endif()

configure_case(valid "ROR_USE_OPENAL" "" "" "" -DROR_USE_OPENAL=ON)
configure_case(explicit-off "ROR_USE_OPENAL" "" "" "Required feature ROR_USE_OPENAL is OFF" -DROR_USE_OPENAL=OFF)
configure_case(cache-on-effective-off "ROR_USE_OPENAL" "OpenAL" "" "Required feature ROR_USE_OPENAL is OFF" -DROR_USE_OPENAL=ON)
configure_case(unknown "ROR_USE_TYPO" "" "" "Unknown required feature 'ROR_USE_TYPO'" -DROR_USE_TYPO=ON)
configure_case(discord-target "ROR_USE_DISCORD_RPC" "" "discord-rpc::discord-rpc" "discord-rpc::discord-rpc is missing")
configure_case(curl-target "ROR_USE_CURL" "" "CURL::libcurl" "CURL::libcurl is missing")

set(all_features "ROR_USE_OPENAL;ROR_USE_DISCORD_RPC;ROR_USE_SOCKETW;ROR_USE_ANGELSCRIPT;ROR_USE_CURL;ROR_USE_CAELUM;ROR_USE_PAGED")
configure_case(multiple "${all_features}" "" "" "")
file(READ "${TEST_BINARY_DIR}/multiple/ror-features.cmake" receipt)
set(expected [=[# Effective optional features after dependency discovery.
set(ROR_REQUIRED_FEATURES "ROR_USE_ANGELSCRIPT;ROR_USE_CAELUM;ROR_USE_CURL;ROR_USE_DISCORD_RPC;ROR_USE_OPENAL;ROR_USE_PAGED;ROR_USE_SOCKETW")
set(ROR_USE_OPENAL ON)
set(ROR_USE_DISCORD_RPC ON)
set(ROR_USE_SOCKETW ON)
set(ROR_USE_ANGELSCRIPT ON)
set(ROR_USE_CURL ON)
set(ROR_USE_CAELUM ON)
set(ROR_USE_PAGED ON)
]=])
if(NOT receipt STREQUAL expected)
    message(FATAL_ERROR "Full requirements receipt is not canonical")
endif()
configure_case(reordered "ROR_USE_PAGED;${all_features};ROR_USE_OPENAL" "" "" "")
file(READ "${TEST_BINARY_DIR}/reordered/ror-features.cmake" reordered)
if(NOT receipt STREQUAL reordered)
    message(FATAL_ERROR "Equivalent requirement lists produced different receipts")
endif()
# Reconfigure a previously successful gate and ensure rejection removes its receipt.
configure_case(valid "ROR_USE_OPENAL" "OpenAL" "" "Required feature ROR_USE_OPENAL is OFF" -DROR_USE_OPENAL=ON)
# -U makes these first-configure cases repeatable with no requirements cache.
configure_case(normal-off "" "" "" "Required feature ROR_USE_OPENAL is OFF"
    -UROR_REQUIRED_FEATURES -DTEST_NORMAL_REQUIRED_FEATURES=ROR_USE_OPENAL -DROR_USE_OPENAL=OFF)
configure_case(normal-on "" "" "" ""
    -UROR_REQUIRED_FEATURES -DTEST_NORMAL_REQUIRED_FEATURES=ROR_USE_OPENAL -DROR_USE_OPENAL=ON)
file(READ "${TEST_BINARY_DIR}/normal-on/ror-features.cmake" receipt)
string(FIND "${receipt}" [=[set(ROR_REQUIRED_FEATURES "ROR_USE_OPENAL")]=] requirement_position)
if(requirement_position EQUAL -1)
    message(FATAL_ERROR "Receipt lost the supplied normal requirement")
endif()
message(STATUS "All required-feature configure checks passed (synthetic discovery only)")
