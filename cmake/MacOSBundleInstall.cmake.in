# Run only on the installed copy, including CPack's disposable staging tree.
set(app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@ROR_MACOS_BUNDLE@")
foreach (name resources content languages plugins.cfg)
    file(CREATE_LINK "../Resources/runtime/${name}" "${app}/Contents/MacOS/${name}" SYMBOLIC)
endforeach ()

include(BundleUtilities)
set(BU_COPY_FULL_FRAMEWORK_CONTENTS ON)
set(BU_CHMOD_BUNDLE_ITEMS ON)
set(plugin_files "")
foreach (plugin IN ITEMS @ROR_MACOS_PLUGIN_FILES@)
    list(APPEND plugin_files "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${plugin}")
endforeach ()
fixup_bundle("${app}" "${plugin_files}" "${app}/Contents/Frameworks;@ROR_MACOS_SEARCH_DIRS@")

# install_name_tool invalidates signatures: sign nested code before the outer app.
find_program(codesign codesign)
if (NOT codesign)
    message(FATAL_ERROR "macOS packaging requires codesign")
endif ()
function(ror_sign path)
    execute_process(COMMAND "${codesign}" --force --sign - --timestamp=none "${path}" RESULT_VARIABLE result)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "codesign failed for ${path}: ${result}")
    endif ()
endfunction()
file(GLOB_RECURSE libraries "${app}/Contents/Frameworks/*.dylib" "${app}/Contents/PlugIns/*.dylib")
foreach (library IN LISTS libraries)
    if (NOT IS_SYMLINK "${library}" AND NOT library MATCHES "\\.framework/")
        ror_sign("${library}")
    endif ()
endforeach ()
file(GLOB frameworks "${app}/Contents/Frameworks/*.framework")
foreach (framework IN LISTS frameworks)
    ror_sign("${framework}")
endforeach ()
ror_sign("${app}")
execute_process(COMMAND "${codesign}" --verify --deep --strict "${app}" RESULT_VARIABLE result)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Installed macOS bundle signature verification failed: ${result}")
endif ()
