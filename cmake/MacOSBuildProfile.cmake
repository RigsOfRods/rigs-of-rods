# The qualified dependency recipes and source pins live in ror-dependencies.
if(NOT APPLE OR NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "ROR_MACOS_GL3_PROFILE requires a native macOS Apple Silicon host.")
endif()
execute_process(COMMAND uname -m OUTPUT_VARIABLE _ror_host_arch OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _ror_host_arch STREQUAL "arm64" OR NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    message(FATAL_ERROR "ROR_MACOS_GL3_PROFILE requires native arm64 and -DCMAKE_OSX_ARCHITECTURES=arm64.")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "ROR_MACOS_GL3_PROFILE supports single-configuration Release only; use Ninja and -DCMAKE_BUILD_TYPE=Release with a Release prefix.")
endif()
if(NOT CMAKE_OSX_SYSROOT OR NOT CMAKE_OSX_DEPLOYMENT_TARGET OR CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS 11.0)
    message(FATAL_ERROR "Select CMAKE_OSX_SYSROOT and CMAKE_OSX_DEPLOYMENT_TARGET (11.0 or newer) to match the dependency build.")
endif()
if(NOT ROR_CREATE_CONTENT_FOLDER OR NOT EXISTS "${CMAKE_SOURCE_DIR}/content/LICENSE")
    message(FATAL_ERROR "Enable ROR_CREATE_CONTENT_FOLDER and initialize the pinned content: git submodule update --init --checkout content")
endif()
if(NOT EXISTS "${ROR_DEPENDENCY_DIR}/version.cmake")
    message(FATAL_ERROR "Set ROR_DEPENDENCY_DIR to the installed native-macos-gl3 Release dependency prefix.")
endif()
get_filename_component(ROR_DEPENDENCY_DIR "${ROR_DEPENDENCY_DIR}" REALPATH)
set(CMAKE_PREFIX_PATH "${ROR_DEPENDENCY_DIR}")
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_FRAMEWORK LAST)
list(APPEND CMAKE_IGNORE_PREFIX_PATH /opt/homebrew /usr/local)
# Apple's SDK OpenAL lacks the Soft EFX headers used by RoR.
set(OPENAL_LIBRARY "${ROR_DEPENDENCY_DIR}/lib/libopenal.dylib")
set(OPENAL_INCLUDE_DIR "${ROR_DEPENDENCY_DIR}/include/AL")

# This named profile promises the complete feature selection. Inspect effective
# dependent options after discovery, including options CMake forced OFF.
function(ror_check_macos_profile)
    foreach(feature ROR_USE_OPENAL ROR_USE_ANGELSCRIPT ROR_USE_CURL
        ROR_USE_SOCKETW ROR_USE_DISCORD_RPC ROR_USE_CAELUM ROR_USE_PAGED)
        add_feature_info(${feature} ${feature} "Native macOS profile selection")
        if(NOT ${feature})
            message(FATAL_ERROR "Native macOS profile: ${feature} is OFF after discovery. Use -D${feature}=ON and the complete qualified prefix, then configure in a clean build directory.")
        endif()
    endforeach()
    get_target_property(_ror_ogre_type OgreMain TYPE)
    if(NOT _ror_ogre_type STREQUAL "SHARED_LIBRARY")
        message(FATAL_ERROR "Native macOS profile requires shared OgreMain from the qualified prefix.")
    endif()
    foreach(plugin RenderSystem_GL3Plus Codec_STBI Plugin_ParticleFX Plugin_OctreeSceneManager)
        if(NOT plugin IN_LIST OGRE_PLUGINS OR NOT EXISTS "${OGRE_PLUGIN_DIR}/${plugin}.dylib")
            message(FATAL_ERROR "Native macOS profile requires the installed OGRE plugin ${plugin} in OGRE_PLUGIN_DIR.")
        endif()
    endforeach()
    if(NOT EXISTS "${Caelum_LIBRARY}")
        message(FATAL_ERROR "Native macOS profile requires the selected Caelum library.")
    endif()
    if(NOT MyGUI_MyGUIEngine_LIBRARY_REL MATCHES "\\.framework$" OR
        NOT EXISTS "${MyGUI_MyGUIEngine_LIBRARY_REL}/MyGUIEngine")
        message(FATAL_ERROR "Native macOS profile requires the qualified complete MyGUIEngine.framework.")
    endif()
    get_filename_component(_ror_mygui_image "${MyGUI_MyGUIEngine_LIBRARY_REL}/MyGUIEngine" REALPATH)
    if(NOT _ror_mygui_image MATCHES "/MyGUIEngine\\.framework/Versions/[^/]+/MyGUIEngine$")
        message(FATAL_ERROR "Preserve MyGUIEngine.framework's Versions directory and symlinks.")
    endif()
endfunction()
