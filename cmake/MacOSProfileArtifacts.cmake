# Selected installed artifacts for the explicit Release profile.
function(ror_macos_prefix_path path label)
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "macOS profile: ${label} is missing or not absolute: '${path}'")
    endif()
    get_filename_component(real "${path}" REALPATH)
    file(RELATIVE_PATH relative "${ROR_DEPENDENCY_DIR}" "${real}")
    if(relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${relative}")
        message(FATAL_ERROR "macOS profile: ${label} escapes selected dependency prefix: '${real}'")
    endif()
    if(IS_DIRECTORY "${path}" AND path MATCHES "\\.framework$")
        get_filename_component(framework_name "${path}" NAME_WE)
        # FindMyGUI returns the framework directory. Check the selected image's
        # own version symlinks as well as its enclosing directory.
        ror_macos_prefix_path("${path}/${framework_name}" "${label}/framework image")
    endif()
endfunction()

# Only the expressions emitted by the current FindMyGUI and imported package
# targets are supported. Unknown expressions must not hide unvalidated paths.
function(ror_macos_release_input input output)
    if(input MATCHES "^\\$<\\$<CONFIG:Debug>:[^<>]*>\\$<\\$<NOT:\\$<CONFIG:Debug>>:([^<>]*)>$")
        set(input "${CMAKE_MATCH_1}")
    elseif(input MATCHES "^\\$<LINK_ONLY:([^<>]*)>$")
        set(input "${CMAKE_MATCH_1}")
    elseif(input MATCHES "\\$<")
        message(FATAL_ERROR "macOS profile: unsupported selected link/include expression '${input}'")
    endif()
    set(${output} "${input}" PARENT_SCOPE)
endfunction()

function(ror_macos_link_path path label)
    # SDK/system inputs remain OS inputs; third-party paths must be in P.
    get_filename_component(real "${path}" REALPATH)
    if(real MATCHES "^(/System/Library/|/usr/lib/)")
        return()
    endif()
    if(CMAKE_OSX_SYSROOT)
        get_filename_component(sdk "${CMAKE_OSX_SYSROOT}" REALPATH)
        file(RELATIVE_PATH relative "${sdk}" "${real}")
        if(relative MATCHES "^(System/Library/|usr/lib/)" AND EXISTS "${real}")
            return()
        endif()
    endif()
    ror_macos_prefix_path("${path}" "${label}")
endfunction()

function(ror_macos_target target)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "macOS profile requires dependency target ${target}")
    endif()
    get_target_property(alias ${target} ALIASED_TARGET)
    if(alias)
        set(target "${alias}")
    endif()
    set(visited ${ARGN})
    if(target IN_LIST visited)
        return()
    endif()
    list(APPEND visited "${target}")
    get_target_property(imported ${target} IMPORTED)
    get_target_property(type ${target} TYPE)
    if(NOT imported)
        message(FATAL_ERROR "macOS profile: dependency ${target} must be an installed imported target")
    endif()
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
        # LOCATION_Release uses CMake's own MAP_IMPORTED_CONFIG_RELEASE and
        # imported-configuration fallback selection, just like TARGET_FILE.
        get_target_property(path ${target} LOCATION_RELEASE)
        if(NOT path OR path MATCHES "\\$<")
            message(FATAL_ERROR "macOS profile: no supported concrete Release location for ${target}")
        endif()
        ror_macos_prefix_path("${path}" "${target}/selected Release location")
    endif()
    get_target_property(includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
    if(includes)
        foreach(input IN LISTS includes)
            ror_macos_release_input("${input}" path)
            if(NOT path STREQUAL "")
                ror_macos_prefix_path("${path}" "${target}/include")
            endif()
        endforeach()
    endif()
    get_target_property(links ${target} INTERFACE_LINK_LIBRARIES)
    if(links)
        foreach(input IN LISTS links)
            ror_macos_release_input("${input}" link)
            if(link STREQUAL "")
                continue()
            elseif(TARGET "${link}")
                ror_macos_target("${link}" ${visited})
            elseif(IS_ABSOLUTE "${link}")
                ror_macos_link_path("${link}" "${target}/selected interface library")
            elseif(link MATCHES "^-framework ([A-Za-z0-9_]+)$")
                ror_macos_link_path("${CMAKE_OSX_SYSROOT}/System/Library/Frameworks/${CMAKE_MATCH_1}.framework" "${target}/SDK framework")
            else()
                message(FATAL_ERROR "macOS profile: unsupported selected link input '${link}' on ${target}; use an imported target or a concrete prefix/SDK path")
            endif()
        endforeach()
    elseif(type STREQUAL "INTERFACE_LIBRARY" AND NOT target STREQUAL "Threads::Threads")
        message(FATAL_ERROR "macOS profile requires a concrete installed artifact for ${target}")
    endif()
    # This recipe graph uses modern link interfaces. Reject alternate mechanisms
    # rather than silently approving inputs this validator has not selected.
    get_target_property(configurations ${target} IMPORTED_CONFIGURATIONS)
    if(NOT configurations)
        set(configurations)
    endif()
    list(APPEND configurations RELEASE NOCONFIG)
    set(unsupported INTERFACE_LINK_OPTIONS INTERFACE_LINK_DIRECTORIES
        INTERFACE_LINK_LIBRARIES_DIRECT INTERFACE_LINK_LIBRARIES_DIRECT_EXCLUDE)
    foreach(property IMPORTED_LINK_INTERFACE_LIBRARIES IMPORTED_LINK_DEPENDENT_LIBRARIES
        IMPORTED_IMPLIB IMPORTED_LIBNAME IMPORTED_NO_SONAME)
        list(APPEND unsupported "${property}")
        foreach(configuration IN LISTS configurations)
            string(TOUPPER "${configuration}" configuration)
            list(APPEND unsupported "${property}_${configuration}")
        endforeach()
    endforeach()
    foreach(property IN LISTS unsupported)
        get_target_property(value ${target} ${property})
        if(value)
            message(FATAL_ERROR "macOS profile: unsupported ${property} on ${target}: '${value}'")
        endif()
    endforeach()
endfunction()
